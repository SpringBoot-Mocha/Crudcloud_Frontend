# CrudCloud Frontend - Environment Variables for Docker Production

# ============================================================================
# API CONFIGURATION
# ============================================================================
# Backend API base URL - MUST USE HTTPS to avoid Mixed Content errors
VITE_API_BASE_URL=https://api.mocha.crudzaso.com/api/v1
# Request timeout in milliseconds
VITE_API_TIMEOUT=15000

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================
VITE_APP_NAME=CrudCloud
VITE_APP_VERSION=1.0.0
# Application URL (used for OAuth callbacks) - MUST USE HTTPS
VITE_APP_URL=https://mocha.crudzaso.com

# ============================================================================
# OAUTH CONFIGURATION (Google and GitHub)
# ============================================================================
# Google OAuth - Get from: https://console.cloud.google.com/
# Project: CrudCloud
VITE_GOOGLE_CLIENT_ID=60736221772-qu02faouq22nm1747c09ivtjb0m8298s.apps.googleusercontent.com

# GitHub OAuth - Get from: https://github.com/settings/developers
# DO NOT include client secret in frontend (handled by backend)
VITE_GITHUB_CLIENT_ID=Ov23litGnx91sQu0tdPN

# ============================================================================
# FEATURE FLAGS
# ============================================================================
# Use mock API instead of real backend
VITE_ENABLE_MOCK_API=false
# Enable debug logging in browser console
VITE_ENABLE_DEBUG_LOGGING=false

# ============================================================================
# MERCADO PAGO CONFIGURATION
# ============================================================================
VITE_MP_PUBLIC_KEY=YOUR_MERCADOPAGO_PUBLIC_KEY_HERE
