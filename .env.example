# CrudCloud Frontend - Environment Variables Example
# Copy this file to .env for development
# DO NOT commit .env file with real values - use .env.example for documentation only

# ============================================================================
# API CONFIGURATION
# ============================================================================
# Backend API base URL
VITE_API_BASE_URL=http://localhost:8080/api/v1
# Request timeout in milliseconds
VITE_API_TIMEOUT=15000

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================
VITE_APP_NAME=CrudCloud
VITE_APP_VERSION=1.0.0
# Application URL (used for OAuth callbacks)
VITE_APP_URL=http://localhost:3000

# ============================================================================
# OAUTH CONFIGURATION (Google and GitHub)
# ============================================================================
# Google OAuth - Get from: https://console.cloud.google.com/
# Project: CrudCloud (67505462880)
VITE_GOOGLE_CLIENT_ID=60736221772-qu02faouq22nm1747c09ivtjb0m8298s.apps.googleusercontent.com

# GitHub OAuth - Get from: https://github.com/settings/developers
# Registered OAuth App: CrudCloud
# DO NOT include client secret in frontend (handled by backend)
VITE_GITHUB_CLIENT_ID=Ov23litGnx91sQu0tdPN

# ============================================================================
# FEATURE FLAGS
# ============================================================================
# Use mock API instead of real backend
VITE_ENABLE_MOCK_API=false
# Enable debug logging in browser console
VITE_ENABLE_DEBUG_LOGGING=true

# ============================================================================
# MERCADO PAGO CONFIGURATION (Optional - for payments)
# ============================================================================
# Get from: https://www.mercadopago.com/developers
VITE_MP_PUBLIC_KEY=YOUR_MERCADOPAGO_PUBLIC_KEY_HERE
